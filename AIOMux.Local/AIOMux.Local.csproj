<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Title>AIOMux Local</Title>
		<Version>0.1.0</Version>
		<Authors>Adrian Cantu</Authors>
		<Company>AIOMux</Company>
		<Product>AIOMux Local</Product>
		<Description>Local solution runner and orchestration for AIOMux.</Description>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<StartupObject>AIOMux.Local.Program</StartupObject>
		<GauntletDemoDirectory>C:\Users\adria\source\repos\AIOMux.Gauntlet\demo\gauntlet\</GauntletDemoDirectory>
		<LocalRunnerExePath>$([System.IO.Path]::ChangeExtension('$(TargetPath)', '.exe'))</LocalRunnerExePath>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\AIOMux.Clients\AIOMux.Clients.csproj" />
		<ProjectReference Include="..\AIOMux.Core\AIOMux.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0-rc.2.25502.107" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0-rc.2.25502.107" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0-rc.2.25502.107" />
	</ItemGroup>

	<Target Name="MoveLocalRunnerExeToGauntletDemo" AfterTargets="Build" Condition="Exists('$(LocalRunnerExePath)')">
		<MakeDir Directories="$(GauntletDemoDirectory)" />
		<Move SourceFiles="$(LocalRunnerExePath)" DestinationFolder="$(GauntletDemoDirectory)" />
	</Target>

	<Target Name="CopySafeRepoOnboardingSolution" AfterTargets="Build">
		<ItemGroup>
			<_SolutionFiles Include="$(MSBuildProjectDirectory)\..\solutions\safe-repo-onboarding\**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(_SolutionFiles)"
			  DestinationFiles="@(_SolutionFiles->'$(OutputPath)solutions\safe-repo-onboarding\%(RecursiveDir)%(Filename)%(Extension)')"
			  SkipUnchangedFiles="true" />
	</Target>

</Project>
