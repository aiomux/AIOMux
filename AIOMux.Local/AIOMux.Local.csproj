<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>AIOMux Local</Title>
    <Version>0.1.0</Version>
    <Authors>Adrian Cantu</Authors>
    <Company>AIOMux</Company>
    <Product>AIOMux Local</Product>
    <Description>Local solution runner and orchestration for AIOMux.</Description>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <StartupObject>AIOMux.Local.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIOMux.Clients\AIOMux.Clients.csproj" />
    <ProjectReference Include="..\AIOMux.Core\AIOMux.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Commands\" />
    <Folder Include="Config\" />
    <Folder Include="Examples\plans\" />
    <Folder Include="Gauntlets\Tools\" />
    <Folder Include="Skills\" />
  </ItemGroup>

</Project>
