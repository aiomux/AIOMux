<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>AIOMux Clients</Title>
    <Version>0.5.0</Version>
    <Authors>Adrian Cantu</Authors>
    <Company>AIOMux</Company>
    <Product>AIOMux Clients</Product>
    <Description>LLM client implementations for AIOMux, including Ollama and OpenAI integrations for agent-driven workflows.</Description>
    <PackageProjectUrl>https://aiomux.ai</PackageProjectUrl>
    <RepositoryUrl>https://github.com/aiomux/AIOMux/</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>aiomux;llm;ollama;openai;agents;AI;Artificial-Intelligence;Agent;Orchestration;LLM;Large-Language-Model;AI-Orchestration;Agent-Framework;C#;.NET;.NetCore;</PackageTags>
    <PackageReleaseNotes>Minor updates.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIOMux.Core\AIOMux.Core.csproj" />
  </ItemGroup>

</Project>
